{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mallang-mahjong",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mallang-mahjong-db",
      "database_id": "7eca4703-edd1-4bad-a338-4126e40ab11c",
      "migrations_dir": "migrations"
    }
  ]
}
